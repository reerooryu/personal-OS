{
  "name": "ascend",
  "version": "0.2.0",
  "private": true,
  "description": "ASCEND: a private RPG-style personal development app",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "verify": "tsx scripts/verify.ts",
    "app:dev": "concurrently -k -n next,app \"cross-env ASCEND_DESKTOP=1 next dev\" \"wait-on http://localhost:3000/api/health && cross-env ASCEND_DEV_URL=http://localhost:3000 electron .\"",
    "package": "node scripts/package-app.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "better-sqlite3": "^13.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.73.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  },
  "main": "electron/main.cjs",
  "productName": "ASCEND",
  "author": "Ryu",
  "build": {
    "appId": "com.ryu.ascend",
    "productName": "ASCEND",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "npmRebuild": false,
    "afterPack": "build/after-pack.cjs",
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "darkModeSupport": true,
      "extendInfo": {
        "NSCalendarsUsageDescription": "ASCEND puts Ryu's timetable and tutoring into a calendar called ASCEND so they show on his iPhone.",
        "NSCalendarsFullAccessUsageDescription": "ASCEND keeps a calendar called ASCEND up to date with Ryu's timetable and tutoring, so they show on his iPhone. It only changes events it created."
      }
    }
  }
}
